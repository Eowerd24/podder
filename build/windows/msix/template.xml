<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="podder"
        Arguments=""
        InstallLocation="C:\Program Files\Podder">
    </Installer>
    <PackageInformation
        PackageName="Podder"
        PackageDisplayName="Podder"
        PublisherName="CN=Podder Contributors"
        PublisherDisplayName="Podder Contributors"
        Version="1.2.0.0"
        PackageDescription="A lightweight desktop GUI and CLI for managing local Podman containers, images, and Compose/Quadlet workloads">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="io.github.eowerd24.podder"
                Description="A lightweight desktop GUI and CLI for managing local Podman containers, images, and Compose/Quadlet workloads"
                DisplayName="Podder"
                ExecutableName="podder"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Podder</DisplayName>
            <PublisherDisplayName>Podder Contributors</PublisherDisplayName>
            <Description>A lightweight desktop GUI and CLI for managing local Podman containers, images, and Compose/Quadlet workloads</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="podder.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
